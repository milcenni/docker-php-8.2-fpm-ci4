# Compose project name (containers become <name>-app-1, <name>-web-1)
PROJECT_NAME=neoterik

# App folder mounted at /var/www/html (put the project files here)
APP_PATH=./html

# Host port nginx listens on (match app.baseURL in the app's .env)
HTTP_PORT=8085

# 1 = composer install --no-dev, 0 = include dev packages
COMPOSER_NO_DEV=1

TZ=Asia/Kuala_Lumpur
